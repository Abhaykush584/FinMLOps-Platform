le options (labels, expiration, tags,\n     kms_key_name). When the table has no rows (e.g. --empty), load_csv_rows is\n     skipped, so we must create the table explicitly via DDL and apply those\n     same options here. #}\n  {% if (agate_table.rows | length) == 0 %}\n    {% set create_sql = default__create_csv_table(model, agate_table) %}\n    {% call statement() %}\n      alter table {{ this.render() }} set {{ bigquery_table_options(config, model, temporary=False) }}\n    {% endcall %}\n    {{ return(create_sql) }}\n  {% endif %}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.default__create_csv_table', 'macro.dbt.statement', 'macro.dbt_bigquery.bigquery_table_options']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'model', 'type': None, 'description': ''}, {'name': 'agate_table', 'type': None, 'description': ''}], 'created_at': 1785240710.0159693, 'supported_languages': None}, 'macro.dbt_bigquery.bigquery__reset_csv_table': {'name': 'bigquery__reset_csv_table', 'resource_type': 'macro', 'package_name': 'dbt_bigquery', 'path': 'macros\\materializations\\seed.sql', 'original_file_path': 'macros\\materializations\\seed.sql', 'unique_id': 'macro.dbt_bigquery.bigquery__reset_csv_table', 'macro_sql': "{% macro bigquery__reset_csv_table(model, full_refresh, old_relation, agate_table) %}\n    {{ adapter.drop_relation(old_relation) }}\n    {# When --empty is used, load_csv_rows is skipped so the table won't be\n       recreated implicitly by load_dataframe. Create it explicitly via DDL. #}\n    {% if (agate_table.rows | length) == 0 %}\n        {{ return(bigquery__create_csv_table(model, agate_table)) }}\n    {% endif %}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt_bigquery.bigquery__create_csv_table']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'sh
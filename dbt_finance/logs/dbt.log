ation suffix is too long (\' ~ suffix_length ~ \' characters). Maximum length is \' ~ relation_max_name_length ~ \' characters.\') %}\n    {% endif %}\n    {% set identifier = base_relation.identifier[:relation_max_name_length - suffix_length] ~ suffix %}\n\n    {{ return(base_relation.incorporate(path={"identifier": identifier })) }}\n\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'base_relation', 'type': None, 'description': ''}, {'name': 'suffix', 'type': None, 'description': ''}, {'name': 'dstring', 'type': None, 'description': ''}], 'created_at': 1785240709.9899752, 'supported_languages': None}, 'macro.dbt_bigquery.bigquery__make_temp_relation': {'name': 'bigquery__make_temp_relation', 'resource_type': 'macro', 'package_name': 'dbt_bigquery', 'path': 'macros\\adapters.sql', 'original_file_path': 'macros\\adapters.sql', 'unique_id': 'macro.dbt_bigquery.bigquery__make_temp_relation', 'macro_sql': '{% macro bigquery__make_temp_relation(base_relation, suffix) %}\n    {% set temp_relation = bigquery__make_relation_with_suffix(base_relation, suffix, dstring=True) %}\n    {{ return(temp_relation) }}\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt_bigquery.bigquery__make_relation_with_suffix']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'base_relation', 'type': None, 'description': ''}, {'name': 'suffix', 'type': None, 'description': ''}], 'created_at': 1785240709.991442, 'supported_languages': None}, 'macro.dbt_bigquery.bigquery__make_intermediate_relation': {'name': 'bigquery__make_intermediate_relation', 'resource_type': 'macro', 'package_name': 'dbt_bigquery', 'path': 'macros\\adapters.sql', 'original_file_path': 'macros\\adapters.s